{
  "openapi": "3.0.3",
  "info": {
    "title": "Report Ingestion & Verification Service API",
    "version": "1.1.0",
    "description": "Serverless API for ingesting, verifying, and publishing disaster reports.",
    "contact": {
      "name": "Akawat Moradsatian",
      "email": "akawat.mor@dome.tu.ac.th"
    }
  },
  "servers": [
    {
      "url": "https://{apiId}.execute-api.{region}.amazonaws.com/{stage}/v1",
      "description": "AWS API Gateway",
      "variables": {
        "apiId": {
          "default": "replace-me"
        },
        "region": {
          "default": "us-east-1"
        },
        "stage": {
          "default": "dev"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Audit"
    },
    {
      "name": "Events"
    },
    {
      "name": "Media"
    },
    {
      "name": "Metadata"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Service dependency health check",
        "responses": {
          "200": {
            "description": "Healthy or degraded",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "post": {
        "tags": [
          "Reports"
        ],
        "operationId": "createReport",
        "summary": "Submit a raw report for async ingestion",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted and queued",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      },
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "listReports",
        "summary": "List reports by status with optional filters",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "RECEIVED",
                "PENDING_REVIEW",
                "VERIFIED",
                "SPAM",
                "REJECTED",
                "DUPLICATE",
                "DELETED"
              ]
            },
            "description": "Validation status filter"
          },
          {
            "name": "min_trust_score",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "high",
                "normal"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            }
          },
          {
            "name": "last_evaluated_key",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Reserved for future pagination support"
          }
        ],
        "responses": {
          "200": {
            "description": "Report summaries",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListReportsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/reports/{report_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReportIdPath"
        }
      ],
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "getReportById",
        "summary": "Get report detail by id",
        "responses": {
          "200": {
            "description": "Report detail",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      },
      "patch": {
        "tags": [
          "Reports"
        ],
        "operationId": "verifyReport",
        "summary": "Verify or reject a report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification updated",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      },
      "delete": {
        "tags": [
          "Reports"
        ],
        "operationId": "deleteReport",
        "summary": "Soft-delete a report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/reports/stats": {
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "getReportStats",
        "summary": "Dashboard statistics",
        "parameters": [
          {
            "name": "timeframe",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_24h",
                "last_7d"
              ],
              "default": "today"
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "bkk",
                "central",
                "north",
                "northeast",
                "south"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stats payload",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/reports/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "operationId": "getAuditLogs",
        "summary": "Get audit logs",
        "parameters": [
          {
            "name": "report_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit list",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogsResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/reports/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "operationId": "getEventLogs",
        "summary": "Get recent EventBridge events",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "verified",
                "status-changed"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event list",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventLogsResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/reports/upload-url": {
      "post": {
        "tags": [
          "Media"
        ],
        "operationId": "createUploadUrl",
        "summary": "Create S3 presigned upload URL",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned URL",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadUrlResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/changelog.xml": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "operationId": "getChangelogRss",
        "summary": "RSS feed for release and contract changes",
        "responses": {
          "200": {
            "description": "RSS 2.0 feed",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "headers": {
      "TraceId": {
        "description": "Trace identifier for request correlation",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "ReportIdPath": {
        "name": "report_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "Bad request",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error404": {
        "description": "Not found",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error409": {
        "description": "Conflict",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error500": {
        "description": "Internal server error",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error503": {
        "description": "Upstream dependency unavailable",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "GeoLocation": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      },
      "SensorData": {
        "type": "object",
        "properties": {
          "sensor_id": {
            "type": "string"
          },
          "sensor_type": {
            "type": "string"
          },
          "site_id": {
            "type": "string"
          },
          "metric_name": {
            "type": "string"
          },
          "metric_value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "threshold": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "metric_name",
          "metric_value"
        ]
      },
      "IngestRequest": {
        "type": "object",
        "required": [
          "reporter_source",
          "reporter_id"
        ],
        "anyOf": [
          {
            "required": [
              "raw_content"
            ]
          },
          {
            "required": [
              "media_urls"
            ]
          },
          {
            "required": [
              "sensor_data"
            ]
          }
        ],
        "properties": {
          "reporter_source": {
            "type": "string"
          },
          "reporter_id": {
            "type": "string"
          },
          "raw_content": {
            "type": "string"
          },
          "media_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensor_data": {
            "$ref": "#/components/schemas/SensorData"
          },
          "geo_location": {
            "$ref": "#/components/schemas/GeoLocation"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source_external_id": {
            "type": "string"
          }
        }
      },
      "IngestAcceptedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "report_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "estimated_wait_time": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ReportSummary": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "trust_score": {
            "type": "integer"
          },
          "suggested_category": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "time_ago": {
            "type": "string"
          }
        }
      },
      "ListReportsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            }
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "ReportDetail": {
        "type": "object",
        "additionalProperties": true
      },
      "VerifyRequest": {
        "type": "object",
        "required": [
          "validation_status",
          "reviewer_id"
        ],
        "properties": {
          "validation_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "SPAM",
              "REJECTED",
              "DUPLICATE"
            ]
          },
          "reviewer_id": {
            "type": "string"
          },
          "reviewer_notes": {
            "type": "string"
          },
          "link_to_incident_id": {
            "type": "string",
            "description": "Optional incident reference to merge into. Only allowed when validation_status is VERIFIED and is validated against Incident Service before the link is stored."
          }
        }
      },
      "VerifyResponse": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string"
          },
          "validation_status": {
            "type": "string"
          },
          "action_taken": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "required": [
          "reason",
          "deleted_by"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "deleted_by": {
            "type": "string"
          }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "StatsResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "timeframe": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "supported_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "total_received_today": {
                "type": "integer"
              },
              "pending_review": {
                "type": "integer"
              },
              "verified_incidents": {
                "type": "integer"
              },
              "spam_rejected": {
                "type": "integer"
              }
            }
          },
          "trending_keywords": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "heatmap_data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "AuditLogsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "EventLogsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "total_count": {
            "type": "integer"
          },
          "log_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UploadUrlRequest": {
        "type": "object",
        "required": [
          "filename",
          "content_type"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "report_id": {
            "type": "string"
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "UploadUrlResponse": {
        "type": "object",
        "properties": {
          "upload_url": {
            "type": "string"
          },
          "media_id": {
            "type": "string"
          },
          "media_url": {
            "type": "string"
          },
          "s3_key": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "method": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "max_file_size_bytes": {
            "type": "integer"
          },
          "instructions": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "integer"
          },
          "components": {
            "type": "object",
            "additionalProperties": {
