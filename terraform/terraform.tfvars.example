# === Example terraform.tfvars ===
# Copy to terraform.tfvars and fill in values
# OR use deploy.sh which auto-generates this from .env

project_name    = "report-verify"
environment     = "dev"
aws_region      = "us-east-1"

# Gemini AI — comma-separated list of API keys (get from Google AI Studio)
# Supports multiple keys for rotation: "key1,key2,key3"
gemini_api_keys = "YOUR_GEMINI_API_KEY_HERE"
gemini_model    = "gemini-2.5-flash-lite"
gemini_model_fallbacks = "gemini-2.5-flash-lite,gemini-2.0-flash,gemini-3.1-flash-lite"

# Lambda config
lambda_memory_size    = 256
lambda_timeout_api    = 30
lambda_timeout_worker = 60

# Trust scoring thresholds
trust_auto_reject   = 30
trust_high_priority = 80

# SQS
sqs_visibility_timeout = 90
sqs_max_receive_count  = 3
